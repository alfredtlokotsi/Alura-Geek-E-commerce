<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Cart | Explore Essence</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .page-title {
            font-size: 2.5rem;
            margin: 40px 0;
            text-align: center;
            color: #FFFFFF;
        }
        .cart-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
            margin: 30px 0;
        }
        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .cart-item {
            display: flex;
            gap: 20px;
            background: #1A1A1A;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid #2D2D2D;
            align-items: center;
        }
        .cart-item img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
        }
        .cart-item-info {
            flex: 1;
        }
        .cart-item-info h3 {
            color: #FFFFFF;
            font-size: 1.1rem;
        }
        .cart-item-info .price {
            color: #D4AF37;
            font-weight: 600;
        }
        .cart-item-info .quantity {
            color: #888;
            font-size: 0.9rem;
        }
        .cart-summary {
            background: #1A1A1A;
            padding: 25px;
            border-radius: 10px;
            border: 1px solid #2D2D2D;
            height: fit-content;
            position: sticky;
            top: 100px;
        }
        .cart-summary h2 {
            color: #D4AF37;
            margin-bottom: 20px;
        }
        .cart-summary .total-row {
            display: flex;
            justify-content: space-between;
            color: #CCCCCC;
            font-size: 1.1rem;
            margin-bottom: 10px;
        }
        .cart-summary .total-row strong {
            color: #D4AF37;
            font-size: 1.3rem;
        }
        .cart-summary .form-group {
            margin-bottom: 15px;
        }
        .cart-summary .form-group label {
            display: block;
            color: #CCCCCC;
            margin-bottom: 5px;
            font-size: 0.9rem;
        }
        .cart-summary .form-group input {
            width: 100%;
            padding: 10px;
            background: #0D0D0D;
            border: 2px solid #2D2D2D;
            border-radius: 8px;
            color: #FFFFFF;
            font-size: 1rem;
        }
        .cart-summary .form-group input:focus {
            outline: none;
            border-color: #D4AF37;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #888;
            font-size: 1.2rem;
        }
        .empty-state a {
            color: #D4AF37;
            text-decoration: none;
        }
        .empty-state a:hover {
            text-decoration: underline;
        }
        @media (max-width: 768px) {
            .cart-grid {
                grid-template-columns: 1fr;
            }
            .cart-item {
                flex-wrap: wrap;
            }
            .cart-item img {
                width: 60px;
                height: 60px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: locals.user }) %>
    
    <main>
        <div class="container">
            <h1 class="page-title">Your <span class="gold">Cart</span></h1>
            
            <% if (locals.items && locals.items.length > 0) { %>
                <div class="cart-grid">
                    <div class="cart-items">
                        <% locals.items.forEach(item => { %>
                            <div class="cart-item">
                                <img src="/images/<%= item.image_url || 'placeholder.jpg' %>" 
                                     alt="<%= item.name %>" 
                                     onerror="this.src='/images/placeholder.jpg'">
                                <div class="cart-item-info">
                                    <h3><%= item.name %></h3>
                                    <p class="price">R <%= item.price.toFixed(2) %></p>
                                    <p class="quantity">Quantity: <%= item.quantity %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <div class="cart-summary">
                        <h2>Order Summary</h2>
                        <div class="total-row">
                            <span>Total:</span>
                            <strong>R <%= locals.total %></strong>
                        </div>
                        <p style="color: #888; font-size: 0.9rem; margin-bottom: 15px;">
                            Items: <%= locals.items.length %>
                        </p>
                        <form id="checkoutForm">
                            <div class="form-group">
                                <label for="shipping_address">Shipping Address</label>
                                <input type="text" id="shipping_address" 
                                       placeholder="123 Main St, Cape Town" required />
                            </div>
                            <button type="submit" class="btn btn-primary btn-full">Place Order</button>
                        </form>
                    </div>
                </div>
            <% } else { %>
                <p class="empty-state">🛒 Your cart is empty. <a href="/products">Start shopping</a></p>
            <% } %>
        </div>
    </main>

    <script>
        // Make sure addToCart is available
        async function addToCart(productId) {
            const token = localStorage.getItem('token');
            if (!token) {
                alert('Please log in first!');
                document.getElementById('loginBtn')?.click();
                return;
            }

            try {
                const response = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ product_id: productId, quantity: 1 })
                });

                const data = await response.json();
                
                if (response.ok) {
                    alert('✅ Item added to cart!');
                    loadCartCount();
                } else {
                    alert(data.error || 'Failed to add to cart');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                alert('An error occurred. Please try again.');
            }
        }

        // Load cart count
        async function loadCartCount() {
            const token = localStorage.getItem('token');
            if (!token) return;

            try {
                const response = await fetch('/api/cart', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                if (response.ok) {
                    const data = await response.json();
                    const badge = document.getElementById('cartBadge');
                    if (badge) badge.textContent = data.item_count || 0;
                }
            } catch (error) {
                console.error('Error loading cart:', error);
            }
        }

        // Handle checkout
        document.getElementById('checkoutForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const token = localStorage.getItem('token');
            if (!token) {
                alert('Please log in first!');
                return;
            }

            const shipping_address = document.getElementById('shipping_address').value;
            if (!shipping_address) {
                alert('Please enter a shipping address.');
                return;
            }

            try {
                const response = await fetch('/api/checkout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ shipping_address })
                });

                const data = await response.json();
                
                if (response.ok) {
                    alert('✅ Order placed successfully!');
                    window.location.href = '/orders';
                } else {
                    alert(data.error || 'Failed to place order');
                }
            } catch (error) {
                console.error('Error placing order:', error);
                alert('An error occurred. Please try again.');
            }
        });

        // Load cart count on page load
        document.addEventListener('DOMContentLoaded', loadCartCount);
    </script>

    <%- include('../partials/footer', { user: locals.user }) %>
</body>
</html>