<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Suits Collection | Explore Essence</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .category-hero {
            padding: 60px 0;
            text-align: center;
            background: linear-gradient(135deg, #0D0D0D 0%, #1A1A1A 100%);
            border-bottom: 1px solid #2D2D2D;
            margin-bottom: 30px;
        }
        .category-hero h1 {
            font-size: 3rem;
            color: #FFFFFF;
        }
        .category-hero h1 .gold {
            color: #D4AF37;
        }
        .category-hero p {
            color: #AAAAAA;
            font-size: 1.2rem;
            max-width: 600px;
            margin: 10px auto 0;
        }
        .category-hero .category-icon {
            font-size: 3rem;
            color: #D4AF37;
            margin-bottom: 15px;
        }
        .suit-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            margin: 40px 0;
        }
        .suit-card {
            background: linear-gradient(145deg, #1A1A1A, #0D0D0D);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2D2D2D;
            transition: all 0.3s ease;
            position: relative;
        }
        .suit-card:hover {
            transform: translateY(-8px);
            border-color: #D4AF37;
            box-shadow: 0 12px 40px rgba(212, 175, 55, 0.15);
        }
        .suit-card .featured-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #D4AF37;
            color: #1A1A1A;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            z-index: 10;
        }
        .suit-card .image-container {
            width: 100%;
            height: 320px;
            overflow: hidden;
            background: #0D0D0D;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
        }
        .suit-card .image-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.5s ease;
            padding: 10px;
            background: #0D0D0D;
        }
        .suit-card:hover .image-container img {
            transform: scale(1.02);
        }
        .suit-card .image-container .zoom-icon {
            position: absolute;
            bottom: 15px;
            right: 15px;
            background: rgba(212, 175, 55, 0.9);
            color: #1A1A1A;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .suit-card .image-container:hover .zoom-icon {
            opacity: 1;
        }
        .suit-card .info {
            padding: 20px;
            text-align: left;
        }
        .suit-card .info h3 {
            color: #FFFFFF;
            font-size: 1rem;
            margin-bottom: 8px;
            line-height: 1.4;
        }
        .suit-card .info .suit-details {
            color: #888;
            font-size: 0.8rem;
            margin-bottom: 4px;
        }
        .suit-card .info .suit-details i {
            color: #D4AF37;
            width: 16px;
        }
        .suit-card .info .price {
            color: #D4AF37;
            font-size: 1.3rem;
            font-weight: 700;
            margin: 10px 0 8px;
        }
        .suit-card .info .stock {
            color: #888;
            font-size: 0.8rem;
            margin-bottom: 12px;
        }
        .suit-card .info .stock .in-stock {
            color: #2ecc71;
        }
        .suit-card .info .stock .out-of-stock {
            color: #FF4444;
        }
        .suit-card .info .btn {
            width: 100%;
        }
        .suit-card .info .accessories {
            color: #666;
            font-size: 0.75rem;
            margin: 8px 0;
            padding: 8px 10px;
            background: #0D0D0D;
            border-radius: 6px;
            border-left: 2px solid #D4AF37;
        }
        .suit-card .info .pieces-badge {
            display: inline-block;
            background: #D4AF37;
            color: #1A1A1A;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #888;
            font-size: 1.2rem;
        }
        .nav-categories {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            padding: 15px 0;
            background: #0D0D0D;
            border-bottom: 1px solid #2D2D2D;
        }
        .nav-categories a {
            color: #888;
            text-decoration: none;
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #2D2D2D;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }
        .nav-categories a:hover,
        .nav-categories a.active {
            color: #D4AF37;
            border-color: #D4AF37;
            background: rgba(212, 175, 55, 0.1);
        }
        .nav-categories a i {
            margin-right: 8px;
        }

        /* ============================================================
           LIGHTBOX / MODAL FOR FULL IMAGE
           ============================================================ */
        .lightbox {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            padding: 40px;
        }
        .lightbox.active {
            display: flex;
            animation: fadeIn 0.3s ease;
        }
        .lightbox img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
            border-radius: 8px;
            border: 2px solid #D4AF37;
            box-shadow: 0 0 60px rgba(212, 175, 55, 0.2);
        }
        .lightbox .close-lightbox {
            position: absolute;
            top: 30px;
            right: 40px;
            color: #FFFFFF;
            font-size: 3rem;
            cursor: pointer;
            transition: color 0.3s ease;
            z-index: 10000;
            background: none;
            border: none;
        }
        .lightbox .close-lightbox:hover {
            color: #D4AF37;
        }
        .lightbox .lightbox-caption {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: #FFFFFF;
            font-size: 1.1rem;
            text-align: center;
            background: rgba(0, 0, 0, 0.7);
            padding: 12px 24px;
            border-radius: 8px;
            max-width: 80%;
            border: 1px solid rgba(212, 175, 55, 0.3);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        @media (max-width: 768px) {
            .category-hero h1 {
                font-size: 2rem;
            }
            .suit-grid {
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 15px;
            }
            .suit-card .image-container {
                height: 250px;
            }
            .nav-categories {
                gap: 8px;
                padding: 10px;
            }
            .nav-categories a {
                padding: 6px 12px;
                font-size: 0.8rem;
            }
            .lightbox .close-lightbox {
                top: 20px;
                right: 20px;
                font-size: 2rem;
            }
            .lightbox .lightbox-caption {
                font-size: 0.9rem;
                padding: 8px 16px;
                bottom: 20px;
            }
        }
        @media (max-width: 480px) {
            .suit-grid {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
            .suit-card .image-container {
                height: 200px;
            }
            .suit-card .info {
                padding: 12px;
            }
            .suit-card .info h3 {
                font-size: 0.85rem;
            }
            .suit-card .info .price {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: locals.user }) %>
    
    <!-- Category Navigation -->
    <nav class="nav-categories">
        <%
            const navCategories = [
                { slug: 'perfumes', name: 'Perfumes', icon: 'fa-perfume' },
                { slug: 'fans', name: 'Fans', icon: 'fa-fan' },
                { slug: 'ties', name: 'Ties', icon: 'fa-tie' },
                { slug: 'suits', name: 'Suits', icon: 'fa-user-tie' },
                { slug: 'tools', name: 'Tools', icon: 'fa-tools' }
            ];
            navCategories.forEach(cat => {
                const isActive = cat.slug === 'suits';
        %>
            <a href="/category/<%= cat.slug %>" class="<%= isActive ? 'active' : '' %>">
                <i class="fas <%= cat.icon %>"></i> <%= cat.name %>
            </a>
        <% }); %>
        <a href="/suits" class="active" style="background: rgba(212,175,55,0.2);">
            <i class="fas fa-tshirt"></i> All Suits
        </a>
    </nav>
    
    <main>
        <div class="category-hero">
            <div class="container">
                <div class="category-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h1><span class="gold">Premium Suits</span></h1>
                <p>Tailored elegance for the modern gentleman</p>
            </div>
        </div>

        <div class="container">
            <% if (suits && suits.length > 0) { %>
                <div style="text-align: right; color: #888; font-size: 0.9rem; margin-bottom: 10px;">
                    <%= suits.length %> suits available
                </div>
                <div class="suit-grid">
                    <% suits.forEach(suit => { %>
                        <div class="suit-card">
                            <% if (suit.featured) { %>
                                <span class="featured-badge">⭐ Featured</span>
                            <% } %>
                            <div class="image-container" onclick="openLightbox('/images/<%= suit.image_url %>', '<%= suit.product_name %>')">
                                <img src="/images/<%= suit.image_url || 'placeholder.jpg' %>" 
                                     alt="<%= suit.product_name %>" 
                                     onerror="this.src='/images/placeholder.jpg'">
                                <div class="zoom-icon">
                                    <i class="fas fa-expand"></i>
                                </div>
                            </div>
                            <div class="info">
                                <span class="pieces-badge"><%= suit.pieces_count %>-Piece</span>
                                <h3><%= suit.product_name %></h3>
                                <p class="suit-details"><i class="fas fa-palette"></i> <%= suit.color || 'N/A' %></p>
                                <p class="suit-details"><i class="fas fa-tshirt"></i> <%= suit.fit_type || 'Classic' %></p>
                                <p class="suit-details"><i class="fas fa-vest"></i> <%= suit.jacket_style || 'Classic' %></p>
                                <% if (suit.waistcoat_style) { %>
                                    <p class="suit-details"><i class="fas fa-layer-group"></i> <%= suit.waistcoat_style %></p>
                                <% } %>
                                <% if (suit.accessories_included) { %>
                                    <div class="accessories">
                                        <i class="fas fa-gift"></i> <%= suit.accessories_included.substring(0, 60) %><%= suit.accessories_included.length > 60 ? '...' : '' %>
                                    </div>
                                <% } %>
                                <p class="price">R <%= parseFloat(suit.price).toFixed(2) %></p>
                                <p class="stock">
                                    <% if (suit.stock_quantity > 0) { %>
                                        ✅ <span class="in-stock">In Stock</span> (<%= suit.stock_quantity %> available)
                                    <% } else { %>
                                        ❌ <span class="out-of-stock">Out of Stock</span>
                                    <% } %>
                                </p>
                                <button class="btn btn-primary btn-sm" onclick="addSuitToCart(<%= suit.id %>)">
                                    <i class="fas fa-cart-plus"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-box-open" style="font-size: 3rem; display: block; margin-bottom: 15px; color: #555;"></i>
                    No suits available yet. Check back soon!
                </div>
            <% } %>
        </div>
    </main>

    <!-- ============================================================
    LIGHTBOX / MODAL FOR FULL IMAGE
    ============================================================ -->
    <div class="lightbox" id="lightbox" onclick="closeLightbox()">
        <button class="close-lightbox" onclick="closeLightbox()">&times;</button>
        <img id="lightboxImage" src="" alt="Suit Image" />
        <div class="lightbox-caption" id="lightboxCaption"></div>
    </div>

    <script>
        // ============================================================
        // LIGHTBOX FUNCTIONS
        // ============================================================
        function openLightbox(imageUrl, caption) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightboxImage');
            const captionEl = document.getElementById('lightboxCaption');
            
            img.src = imageUrl;
            captionEl.textContent = caption;
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
        }

        // Close lightbox with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });

        // ============================================================
        // ADD TO CART
        // ============================================================
        async function addSuitToCart(suitId) {
            const token = localStorage.getItem('token');
            if (!token) {
                alert('Please log in first!');
                document.getElementById('loginBtn')?.click();
                return;
            }

            try {
                const response = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ product_id: suitId, quantity: 1 })
                });

                const data = await response.json();
                
                if (response.ok) {
                    showNotification('✅ Suit added to cart!', 'success');
                    const badge = document.getElementById('cartBadge');
                    if (badge) {
                        const current = parseInt(badge.textContent) || 0;
                        badge.textContent = current + 1;
                    }
                } else {
                    showNotification(data.error || 'Failed to add to cart', 'error');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                showNotification('An error occurred. Please try again.', 'error');
            }
        }

        // ============================================================
        // NOTIFICATION
        // ============================================================
        function showNotification(message, type = 'info') {
            const colors = {
                success: '#D4AF37',
                error: '#FF4444',
                info: '#3498db'
            };
            
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                bottom: 20px;
                right: 20px;
                padding: 16px 24px;
                background: #1A1A1A;
                color: #FFFFFF;
                border-left: 4px solid ${colors[type] || '#888'};
                border-radius: 8px;
                box-shadow: 0 8px 30px rgba(0,0,0,0.5);
                z-index: 9999;
                max-width: 400px;
                animation: slideIn 0.3s ease;
                font-size: 0.95rem;
            `;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transition = 'opacity 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
    </script>

    <%- include('../partials/footer', { user: locals.user }) %>
</body>
</html>