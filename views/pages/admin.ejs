<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Explore Essence</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .admin-container {
            max-width: 1400px;
            margin: 40px auto;
            padding: 0 20px;
        }
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 30px;
            background: linear-gradient(145deg, #1A1A1A, #0D0D0D);
            border-radius: 12px;
            border: 1px solid #2D2D2D;
            margin-bottom: 30px;
        }
        .admin-header h1 {
            color: #D4AF37;
            font-size: 1.8rem;
        }
        .admin-header .admin-badge {
            background: #D4AF37;
            color: #1A1A1A;
            padding: 4px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: linear-gradient(145deg, #1A1A1A, #0D0D0D);
            border: 1px solid #2D2D2D;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }
        .stat-card .stat-number {
            color: #D4AF37;
            font-size: 2.5rem;
            font-weight: 700;
        }
        .stat-card .stat-label {
            color: #888;
            font-size: 0.9rem;
            margin-top: 5px;
        }
        .admin-section-title {
            color: #FFFFFF;
            font-size: 1.3rem;
            margin: 30px 0 20px;
        }
        .admin-table-wrapper {
            background: linear-gradient(145deg, #1A1A1A, #0D0D0D);
            border-radius: 12px;
            border: 1px solid #2D2D2D;
            overflow: hidden;
            overflow-x: auto;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }
        .admin-table thead {
            background: #0D0D0D;
            border-bottom: 2px solid #D4AF37;
        }
        .admin-table th {
            color: #D4AF37;
            padding: 15px 20px;
            text-align: left;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .admin-table td {
            color: #CCCCCC;
            padding: 15px 20px;
            border-bottom: 1px solid #1A1A1A;
        }
        .admin-table tr:hover td {
            background: #1A1A1A;
        }
        .role-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .role-badge.admin {
            background: #D4AF37;
            color: #1A1A1A;
        }
        .role-badge.user {
            background: #2D2D2D;
            color: #888;
        }
        .admin-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .admin-actions button {
            padding: 6px 14px;
            border: none;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-toggle-role {
            background: transparent;
            color: #D4AF37;
            border: 1px solid #D4AF37;
        }
        .btn-toggle-role:hover {
            background: #D4AF37;
            color: #1A1A1A;
        }
        .btn-delete-user {
            background: transparent;
            color: #FF4444;
            border: 1px solid #FF4444;
        }
        .btn-delete-user:hover {
            background: #FF4444;
            color: #1A1A1A;
        }
        .create-admin-box {
            background: linear-gradient(145deg, #1A1A1A, #0D0D0D);
            border: 1px solid #2D2D2D;
            border-radius: 12px;
            padding: 30px;
            max-width: 500px;
            margin: 30px 0;
        }
        .create-admin-box h3 {
            color: #D4AF37;
            margin-bottom: 20px;
        }
        .create-admin-box .form-group {
            margin-bottom: 15px;
        }
        .create-admin-box .form-group label {
            display: block;
            color: #CCCCCC;
            font-weight: 500;
            margin-bottom: 6px;
            font-size: 0.9rem;
        }
        .create-admin-box .form-group input {
            width: 100%;
            padding: 10px 14px;
            background: #0D0D0D;
            border: 2px solid #2D2D2D;
            border-radius: 8px;
            color: #FFFFFF;
            font-size: 1rem;
        }
        .create-admin-box .form-group input:focus {
            outline: none;
            border-color: #D4AF37;
        }
        .error-box {
            text-align: center;
            padding: 60px 20px;
            background: #1A1A1A;
            border-radius: 12px;
            border: 1px solid #2D2D2D;
        }
        .error-box i {
            font-size: 3rem;
            color: #FF4444;
            margin-bottom: 20px;
        }
        .error-box h2 {
            color: #FFFFFF;
            margin-bottom: 10px;
        }
        .error-box p {
            color: #888;
            margin-bottom: 20px;
        }
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #888;
        }
        @media (max-width: 768px) {
            .admin-table {
                font-size: 0.85rem;
                min-width: 500px;
            }
            .admin-table th,
            .admin-table td {
                padding: 10px 12px;
            }
            .admin-actions {
                flex-direction: column;
            }
            .admin-actions button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: locals.user }) %>
    
    <main>
        <% if (!locals.user) { %>
            <div class="admin-container">
                <div class="error-box">
                    <i class="fas fa-lock"></i>
                    <h2>Access Denied</h2>
                    <p>Please log in to access the admin dashboard.</p>
                    <button class="btn btn-primary" id="loginBtn">Log In</button>
                </div>
            </div>
        <% } else if (locals.user.role !== 'admin') { %>
            <div class="admin-container">
                <div class="error-box">
                    <i class="fas fa-lock"></i>
                    <h2>Access Denied</h2>
                    <p>You don't have admin privileges.</p>
                    <a href="/" class="btn btn-primary">Go Home</a>
                </div>
            </div>
        <% } else { %>
            <div class="admin-container">
                <div class="admin-header">
                    <h1>👑 Admin Dashboard</h1>
                    <span class="admin-badge">Admin</span>
                </div>

                <!-- Stats -->
                <div class="admin-stats">
                    <div class="stat-card">
                        <div class="stat-number"><%= locals.users.length %></div>
                        <div class="stat-label">Total Users</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= locals.users.filter(u => u.role === 'admin').length %></div>
                        <div class="stat-label">Admins</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= locals.users.filter(u => u.role === 'user').length %></div>
                        <div class="stat-label">Regular Users</div>
                    </div>
                </div>

                <!-- Create Admin -->
                <div class="create-admin-box">
                    <h3>➕ Create New Admin Account</h3>
                    <form id="createAdminForm">
                        <div class="form-group">
                            <label for="adminName">Full Name</label>
                            <input type="text" id="adminName" placeholder="John Doe" required />
                        </div>
                        <div class="form-group">
                            <label for="adminEmail">Email</label>
                            <input type="email" id="adminEmail" placeholder="admin@example.com" required />
                        </div>
                        <div class="form-group">
                            <label for="adminPassword">Password</label>
                            <input type="password" id="adminPassword" placeholder="At least 6 characters" required />
                        </div>
                        <button type="submit" class="btn btn-primary">Create Admin</button>
                    </form>
                </div>

                <!-- Users Table -->
                <h2 class="admin-section-title">All Users</h2>
                <div class="admin-table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% locals.users.forEach(u => { %>
                                <tr>
                                    <td><%= u.id %></td>
                                    <td><%= u.name %></td>
                                    <td><%= u.email %></td>
                                    <td>
                                        <span class="role-badge <%= u.role === 'admin' ? 'admin' : 'user' %>">
                                            <%= u.role || 'user' %>
                                        </span>
                                    </td>
                                    <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <div class="admin-actions">
                                            <% if (u.id !== locals.user.id) { %>
                                                <button class="btn-toggle-role" 
                                                        onclick="toggleRole(<%= u.id %>, '<%= u.role %>')">
                                                    <%= u.role === 'admin' ? 'Remove Admin' : 'Make Admin' %>
                                                </button>
                                                <button class="btn-delete-user" 
                                                        onclick="deleteUser(<%= u.id %>)">
                                                    Delete
                                                </button>
                                            <% } else { %>
                                                <span style="color: #555; font-size: 0.8rem;">(You)</span>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <script>
                // ============================================================
                // ADMIN FUNCTIONS (Client-side)
                // ============================================================

                async function toggleRole(userId, currentRole) {
                    const newRole = currentRole === 'admin' ? 'user' : 'admin';
                    
                    if (!confirm(`Change this user's role to "${newRole}"?`)) return;

                    try {
                        const response = await fetch(`/api/auth/admin/users/${userId}/role`, {
                            method: 'PUT',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${localStorage.getItem('token')}`
                            },
                            body: JSON.stringify({ role: newRole })
                        });

                        const data = await response.json();
                        
                        if (response.ok) {
                            alert('User role updated!');
                            window.location.reload();
                        } else {
                            alert(data.error || 'Failed to update role');
                        }
                    } catch (error) {
                        console.error('Error updating role:', error);
                        alert('An error occurred');
                    }
                }

                async function deleteUser(userId) {
                    if (!confirm('Are you sure you want to delete this user? This cannot be undone.')) return;

                    try {
                        const response = await fetch(`/api/auth/admin/users/${userId}`, {
                            method: 'DELETE',
                            headers: {
                                'Authorization': `Bearer ${localStorage.getItem('token')}`
                            }
                        });

                        const data = await response.json();
                        
                        if (response.ok) {
                            alert('User deleted successfully!');
                            window.location.reload();
                        } else {
                            alert(data.error || 'Failed to delete user');
                        }
                    } catch (error) {
                        console.error('Error deleting user:', error);
                        alert('An error occurred');
                    }
                }

                // Create Admin Form
                document.getElementById('createAdminForm')?.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    
                    const name = document.getElementById('adminName').value;
                    const email = document.getElementById('adminEmail').value;
                    const password = document.getElementById('adminPassword').value;

                    try {
                        const response = await fetch('/api/auth/admin/create', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${localStorage.getItem('token')}`
                            },
                            body: JSON.stringify({ name, email, password })
                        });

                        const data = await response.json();
                        
                        if (response.ok) {
                            alert('Admin account created!');
                            window.location.reload();
                        } else {
                            alert(data.error || 'Failed to create admin');
                        }
                    } catch (error) {
                        console.error('Error creating admin:', error);
                        alert('An error occurred');
                    }
                });

                // Make functions global
                window.toggleRole = toggleRole;
                window.deleteUser = deleteUser;
            </script>
        <% } %>
    </main>

    <%- include('../partials/footer', { user: locals.user }) %>
</body>
</html>