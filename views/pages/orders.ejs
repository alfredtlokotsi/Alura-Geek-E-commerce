<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Orders | Explore Essence</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .page-title {
            font-size: 2.5rem;
            margin: 40px 0;
            text-align: center;
            color: #FFFFFF;
        }
        .orders-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin: 30px 0;
        }
        .order-card {
            background: #1A1A1A;
            border: 1px solid #2D2D2D;
            border-radius: 12px;
            padding: 20px 25px;
            transition: border-color 0.3s ease;
        }
        .order-card:hover {
            border-color: #D4AF37;
        }
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid #2D2D2D;
        }
        .order-header .order-id {
            color: #D4AF37;
            font-weight: 600;
        }
        .order-header .order-date {
            color: #888;
            font-size: 0.9rem;
        }
        .order-status {
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: capitalize;
        }
        .order-status.pending {
            background: #2D2D2D;
            color: #D4AF37;
            border: 1px solid #D4AF37;
        }
        .order-status.processing {
            background: #2D2D2D;
            color: #3498db;
            border: 1px solid #3498db;
        }
        .order-status.shipped {
            background: #2D2D2D;
            color: #2ecc71;
            border: 1px solid #2ecc71;
        }
        .order-status.delivered {
            background: #D4AF37;
            color: #1A1A1A;
        }
        .order-status.cancelled {
            background: #2D2D2D;
            color: #FF4444;
            border: 1px solid #FF4444;
        }
        .order-body {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }
        .order-body .order-total {
            color: #D4AF37;
            font-size: 1.2rem;
            font-weight: 700;
        }
        .order-body .order-items {
            color: #888;
            font-size: 0.9rem;
        }
        .order-body .btn {
            padding: 6px 16px;
            font-size: 0.85rem;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #888;
            font-size: 1.2rem;
        }
        .empty-state a {
            color: #D4AF37;
            text-decoration: none;
        }
        .empty-state a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: locals.user }) %>
    
    <main>
        <div class="container">
            <h1 class="page-title">My <span class="gold">Orders</span></h1>
            
            <% if (locals.orders && locals.orders.length > 0) { %>
                <div class="orders-list">
                    <% locals.orders.forEach(order => { %>
                        <div class="order-card">
                            <div class="order-header">
                                <span class="order-id">#<%= order.id.slice(0, 8) %></span>
                                <span class="order-date"><%= new Date(order.created_at).toLocaleDateString() %> at <%= new Date(order.created_at).toLocaleTimeString() %></span>
                                <span class="order-status <%= order.status %>"><%= order.status %></span>
                            </div>
                            <div class="order-body">
                                <div>
                                    <span class="order-total">R <%= order.total_amount %></span>
                                    <span class="order-items">• <%= order.item_count || 0 %> items</span>
                                </div>
                                <a href="/orders/<%= order.id %>" class="btn btn-outline btn-sm">View Details</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty-state">📦 You haven't placed any orders yet. <a href="/products">Start shopping</a></p>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer', { user: locals.user }) %>
</body>
</html>