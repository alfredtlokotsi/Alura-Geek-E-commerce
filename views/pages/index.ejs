        </section>

        <section class="featured">
            <div class="container">
                <h2 class="section-title">Featured <span class="gold">Products</span></h2>
                <div class="product-grid" id="productGrid">
                    <!-- Products loaded by JavaScript -->
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer', { user: locals.user }) %>
