<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Explore Essence | Home</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <%- include('../partials/header', { user: locals.user }) %>
    
    <main>
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <span class="hero-badge">✨ New Collection</span>
                    <h1>Discover <span class="gold">Essence</span></h1>
                    <p>Premium curated goods for the discerning soul.</p>
                    <div class="hero-buttons">
                        <a href="/products" class="btn btn-primary">Explore Collection</a>
                        <a href="/suits" class="btn btn-outline">Shop Suits</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="categories-section">
            <div class="container">
                <h2 class="section-title">Browse <span class="gold">Categories</span></h2>
                <div class="category-grid">
                    <%
                        const categories = [
                            { slug: 'perfumes', name: 'Perfumes', icon: 'fa-spray-can-sparkles', color: '#D4AF37' },
                            { slug: 'ties', name: 'Ties', icon: 'fa-user-tie', color: '#e74c3c' },
                            { slug: 'suits', name: 'Suits', icon: 'fa-user-tie', color: '#2ecc71' },
                            { slug: 'chinos', name: 'Chinos', icon: 'fa-person', color: '#3498db' },
                            { slug: 'shirts', name: 'Shirts', icon: 'fa-shirt', color: '#f39c12' },
                            { slug: 'trousers', name: 'Trousers', icon: 'fa-socks', color: '#9b59b6' }
                        ];
                        categories.forEach(cat => {
                    %>
                        <a href="/<%= cat.slug %>" class="category-card">
                            <div class="category-icon" style="color: <%= cat.color %>;">
                                <i class="fas <%= cat.icon %>"></i>
                            </div>
                            <h3><%= cat.name %></h3>
                            <span class="category-arrow">→</span>
                        </a>
                    <% }); %>
                </div>
            </div>
        </section>

        <section class="featured">
            <div class="container">
                <h2 class="section-title">Featured <span class="gold">Products</span></h2>
                <div class="product-grid">
                    <% if (featured && featured.length > 0) { %>
                        <% featured.forEach(product => { %>
                            <div class="product-card">
                                <span class="featured-badge">⭐ Featured</span>
                                <img src="/images/<%= product.image_url || 'placeholder.jpg' %>" 
                                     alt="<%= product.name %>" 
                                     onerror="this.src='/images/placeholder.jpg'">
                                <div class="info">
                                    <h3><%= product.name %></h3>
                                    <p class="price">R <%= product.price ? parseFloat(product.price).toFixed(2) : '0.00' %></p>
                                    <div class="product-actions">
                                        <button class="btn btn-primary btn-sm" onclick="addToCart(<%= product.id %>)">
                                            <i class="fas fa-cart-plus"></i> Add
                                        </button>
                                        <button class="btn btn-outline btn-sm" onclick="addToWishlist(<%= product.id %>)">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="text-align:center;color:#888;">No featured products available.</p>
                    <% } %>
                </div>
            </div>
        </section>

        <section class="new-arrivals">
            <div class="container">
                <h2 class="section-title">New <span class="gold">Arrivals</span></h2>
                <div class="product-grid">
                    <% if (newArrivals && newArrivals.length > 0) { %>
                        <% newArrivals.forEach(product => { %>
                            <div class="product-card">
                                <img src="/images/<%= product.image_url || 'placeholder.jpg' %>" 
                                     alt="<%= product.name %>" 
                                     onerror="this.src='/images/placeholder.jpg'">
                                <div class="info">
                                    <h3><%= product.name %></h3>
                                    <p class="price">R <%= product.price ? parseFloat(product.price).toFixed(2) : '0.00' %></p>
                                    <button class="btn btn-primary btn-sm" onclick="addToCart(<%= product.id %>)">
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="text-align:center;color:#888;">No new arrivals yet.</p>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer', { user: locals.user }) %>
</body>
</html>