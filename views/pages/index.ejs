<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home | Explore Essence</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <%- include('../partials/header', { user: locals.user }) %>
    
    <main>
        <section class="hero">
            <div class="container">
                <h1>Discover <span class="gold">Essence</span></h1>
                <p>Premium curated goods for the discerning soul.</p>
                <a href="/products" class="btn btn-primary">Explore Collection</a>
            </div>
        </section>

        <!-- Categories Section -->
        <section class="categories-section">
            <div class="container">
                <h2 class="section-title">Browse <span class="gold">Categories</span></h2>
                <div class="category-grid">
                    <%
                        const categories = [
                            { slug: 'perfumes', name: 'Perfumes', icon: 'fa-perfume', color: '#D4AF37' },
                            { slug: 'fans', name: 'Fans', icon: 'fa-fan', color: '#3498db' },
                            { slug: 'ties', name: 'Ties', icon: 'fa-tie', color: '#e74c3c' },
                            { slug: 'suits', name: 'Suits', icon: 'fa-user-tie', color: '#2ecc71' },
                            { slug: 'tools', name: 'Tools', icon: 'fa-tools', color: '#f39c12' }
                        ];
                        categories.forEach(cat => {
                    %>
                        <a href="/category/<%= cat.slug %>" class="category-card">
                            <div class="category-icon" style="color: <%= cat.color %>;">
                                <i class="fas <%= cat.icon %>"></i>
                            </div>
                            <h3><%= cat.name %></h3>
                            <span class="category-arrow">→</span>
                        </a>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- Featured Products -->
        <section class="featured">
            <div class="container">
                <h2 class="section-title">Featured <span class="gold">Products</span></h2>
                <div class="product-grid">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <div class="product-card">
                                <% if (product.featured) { %>
                                    <span class="featured-badge">⭐ Featured</span>
                                <% } %>
                                <img src="/images/<%= product.image_url || 'placeholder.jpg' %>" 
                                     alt="<%= product.name %>" 
                                     onerror="this.src='/images/placeholder.jpg'">
                                <div class="info">
                                    <h3><%= product.name %></h3>
                                    <p class="price">R <%= parseFloat(product.price).toFixed(2) %></p>
                                    <button class="btn btn-primary btn-sm add-to-cart-btn" 
                                            onclick="addToCart(<%= product.id %>)">
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="text-align:center;color:#888;">No products available.</p>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <script>
        async function addToCart(productId) {
            const token = localStorage.getItem('token');
            if (!token) {
                alert('Please log in first!');
                document.getElementById('loginBtn')?.click();
                return;
            }

            try {
                const response = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ product_id: productId, quantity: 1 })
                });

                const data = await response.json();
                
                if (response.ok) {
                    alert('✅ Item added to cart!');
                    const badge = document.getElementById('cartBadge');
                    if (badge) {
                        const current = parseInt(badge.textContent) || 0;
                        badge.textContent = current + 1;
                    }
                } else {
                    alert(data.error || 'Failed to add to cart');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                alert('An error occurred. Please try again.');
            }
        }
    </script>

    <%- include('../partials/footer', { user: locals.user }) %>
</body>
</html>