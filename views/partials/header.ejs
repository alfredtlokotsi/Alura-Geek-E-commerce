<header class="header">
    <div class="container">
        <div class="header-left">
            <a href="/" class="logo">
                <img src="/images/logo/explore_essence_logo.png" alt="Explore Essence" class="logo-image" />
            </a>
        </div>
        
        <!-- Mobile Menu Toggle -->
        <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">
            <i class="fas fa-bars"></i>
        </button>
        
        <nav class="nav" id="mainNav">
            <a href="/">Home</a>
            <a href="/products">Shop</a>
            <a href="/category/perfumes">Perfumes</a>
            <a href="/category/fans">Fans</a>
            <a href="/category/ties">Ties</a>
            <a href="/suits">Suits</a>
            <a href="/category/tools">Tools</a>
            <a href="/about">About</a>
            <% if (user && user.role === 'admin') { %>
                <a href="/admin" class="admin-link">👑 Admin</a>
            <% } %>
        </nav>
        
        <div class="header-right">
            <!-- Search -->
            <form action="/search" method="GET" class="search-form">
                <input type="text" name="q" placeholder="Search..." aria-label="Search" />
                <button type="submit"><i class="fas fa-search"></i></button>
            </form>
            
            <!-- Cart Icon -->
            <a href="/cart" class="cart-icon" id="cartIcon">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge" id="cartBadge">0</span>
            </a>
            
            <!-- Auth Buttons -->
            <% if (!user) { %>
                <div class="auth-buttons" id="authButtons">
                    <button class="btn btn-outline" id="loginBtn">Log In</button>
                    <button class="btn btn-primary" id="signupBtn">Sign Up</button>
                </div>
            <% } else { %>
                <div class="user-menu active" id="userMenu">
                    <button class="user-avatar" id="userAvatar">
                        <div class="avatar-circle">
                            <i class="fas fa-user"></i>
                        </div>
                        <span class="user-name-display" id="userName"><%= user.name %></span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <div class="dropdown-user-info">
                            <div class="dropdown-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="dropdown-user-details">
                                <strong id="dropdownUserName"><%= user.name %></strong>
                                <span id="dropdownUserEmail"><%= user.email %></span>
                                <span class="dropdown-user-role"><%= user.role || 'User' %></span>
                            </div>
                        </div>
                        <hr />
                        <a href="/profile"><i class="fas fa-user"></i> Profile</a>
                        <a href="/orders"><i class="fas fa-box"></i> My Orders</a>
                        <a href="/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                        <% if (user.role === 'admin') { %>
                            <a href="/admin"><i class="fas fa-crown"></i> Admin Dashboard</a>
                            <a href="/database"><i class="fas fa-database"></i> Database</a>
                        <% } %>
                        <hr />
                        <a href="#" id="logoutBtn" class="logout-link">
                            <i class="fas fa-sign-out-alt"></i> Log Out
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobileMenu">
    <a href="/">Home</a>
    <a href="/products">Shop All</a>
    <a href="/category/perfumes">Perfumes</a>
    <a href="/category/fans">Fans</a>
    <a href="/category/ties">Ties</a>
    <a href="/suits">Suits</a>
    <a href="/category/tools">Tools</a>
    <a href="/about">About</a>
    <% if (user && user.role === 'admin') { %>
        <a href="/admin">👑 Admin</a>
    <% } %>
    <hr />
    <a href="/cart">🛒 Cart</a>
    <a href="/orders">📦 Orders</a>
    <a href="/wishlist">❤️ Wishlist</a>
</div>

<script>
    function toggleMobileMenu() {
        const menu = document.getElementById('mobileMenu');
        menu.classList.toggle('active');
    }

    // Close mobile menu when clicking a link
    document.querySelectorAll('#mobileMenu a').forEach(link => {
        link.addEventListener('click', () => {
            document.getElementById('mobileMenu').classList.remove('active');
        });
    });
</script>