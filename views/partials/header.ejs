<header class="header">
    <div class="container">
        <div class="header-left">
            <a href="/" class="logo">✨ Explore Essence</a>
        </div>
        <nav class="nav">
            <a href="/">Home</a>
            <a href="/products">Shop</a>
            <a href="/about">About</a>
            <% if (user && user.role === 'admin') { %>
                <a href="/admin" class="admin-link">👑 Admin</a>
            <% } %>
        </nav>
        <div class="header-right">
            <!-- Cart Icon -->
            <a href="/cart" class="cart-icon" id="cartIcon">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge" id="cartBadge">0</span>
            </a>
            
            <!-- Auth Buttons (shown when logged out) -->
            <% if (!user) { %>
                <div class="auth-buttons" id="authButtons">
                    <button class="btn btn-outline" id="loginBtn">Log In</button>
                    <button class="btn btn-primary" id="signupBtn">Sign Up</button>
                </div>
            <% } else { %>
                <!-- User Menu (shown when logged in) -->
                <div class="user-menu active" id="userMenu">
                    <button class="user-avatar" id="userAvatar">
                        <i class="fas fa-user"></i>
                        <span id="userName"><%= user.name %></span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <a href="/profile"><i class="fas fa-user"></i> Profile</a>
                        <a href="/orders"><i class="fas fa-box"></i> My Orders</a>
                        <% if (user.role === 'admin') { %>
                            <a href="/admin"><i class="fas fa-crown"></i> Admin Dashboard</a>
                        <% } %>
                        <hr />
                        <a href="#" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Log Out</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</header>

<!-- ===== MODALS ===== -->
<!-- Login Modal -->
<div class="modal" id="loginModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Welcome Back</h2>
            <button class="modal-close" id="closeLoginModal">&times;</button>
        </div>
        <form id="loginForm" class="auth-form">
            <div class="form-group">
                <label for="loginEmail">Email</label>
                <input type="email" id="loginEmail" placeholder="you@example.com" required />
            </div>
            <div class="form-group">
                <label for="loginPassword">Password</label>
                <input type="password" id="loginPassword" placeholder="Enter your password" required />
            </div>
            <div class="form-error" id="loginError"></div>
            <button type="submit" class="btn btn-primary btn-full">Log In</button>
            <p class="form-footer">
                Don't have an account? <a href="#" id="switchToSignup">Sign up</a>
            </p>
        </form>
    </div>
</div>

<!-- Signup Modal -->
<div class="modal" id="signupModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Create Account</h2>
            <button class="modal-close" id="closeSignupModal">&times;</button>
        </div>
        <form id="signupForm" class="auth-form">
            <div class="form-group">
                <label for="signupName">Full Name</label>
                <input type="text" id="signupName" placeholder="John Doe" required />
            </div>
            <div class="form-group">
                <label for="signupEmail">Email</label>
                <input type="email" id="signupEmail" placeholder="you@example.com" required />
            </div>
            <div class="form-group">
                <label for="signupPassword">Password</label>
                <input type="password" id="signupPassword" placeholder="At least 6 characters" required />
            </div>
            <div class="form-error" id="signupError"></div>
            <button type="submit" class="btn btn-primary btn-full">Create Account</button>
            <p class="form-footer">
                Already have an account? <a href="#" id="switchToLogin">Log in</a>
            </p>
        </form>
    </div>
</div>

<script>
    // Auth functions will be loaded from /js/auth.js
</script>